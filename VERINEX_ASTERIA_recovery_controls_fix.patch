diff --git a/frontend/src/pages/workspaceRecovery.test.ts b/frontend/src/pages/workspaceRecovery.test.ts
new file mode 100644
index 0000000..7ff1628
--- /dev/null
+++ b/frontend/src/pages/workspaceRecovery.test.ts
@@ -0,0 +1,40 @@
+import {describe,expect,it} from 'vitest'
+import {workspaceRecoveryState} from './workspaceRecovery'
+
+const checkpoint={revision:42,reactive_affected_tasks:[]}
+const complete=Array.from({length:4},()=>({status:'COMPLETED'}))
+const run=(status:string,recovery_available=true)=>({status,recovery_available})
+
+describe('Workspace recovery action eligibility',()=>{
+  it('does not offer retry for an evidence-review-only Asteria investigation',()=>{
+    const state=workspaceRecoveryState(run('NEEDS_REVIEW'),checkpoint,complete)
+    expect(state.reviewOnly).toBe(true)
+    expect(state.canRetry).toBe(false)
+    expect(state.hasCheckpoint).toBe(true)
+  })
+  it('does not offer retry when pre-supervisor startup failed without a checkpoint',()=>{
+    const state=workspaceRecoveryState(run('FAILED'),undefined,[])
+    expect(state.missingCheckpoint).toBe(true)
+    expect(state.canRetry).toBe(false)
+  })
+  it('offers retry only when failed or blocked tasks have a checkpoint',()=>{
+    const state=workspaceRecoveryState(run('NEEDS_REVIEW'),checkpoint,
+      [{status:'COMPLETED'},{status:'FAILED'},{status:'BLOCKED'}])
+    expect(state.canRetry).toBe(true)
+  })
+  it('offers resume for an interrupted run with a valid checkpoint',()=>{
+    const state=workspaceRecoveryState(run('INTERRUPTED'),checkpoint,[])
+    expect(state.canResume).toBe(true)
+    expect(state.canRetry).toBe(false)
+  })
+  it('keeps actions disabled when workspace does not authorize recovery',()=>{
+    const state=workspaceRecoveryState(run('FAILED',false),checkpoint,[{status:'FAILED'}])
+    expect(state.canRetry).toBe(false)
+  })
+  it('allows targeted evidence re-verification if checkpoint explicitly lists affected tasks',()=>{
+    const state=workspaceRecoveryState(run('NEEDS_REVIEW'),
+      {revision:44,reactive_affected_tasks:['verify_findings']},complete)
+    expect(state.canRetry).toBe(true)
+    expect(state.reviewOnly).toBe(false)
+  })
+})
diff --git a/frontend/src/pages/workspaceRecovery.ts b/frontend/src/pages/workspaceRecovery.ts
new file mode 100644
index 0000000..910c04c
--- /dev/null
+++ b/frontend/src/pages/workspaceRecovery.ts
@@ -0,0 +1,26 @@
+/** Derive recoverable actions from persisted state, not the NEEDS_REVIEW label alone. */
+export type RecoveryWorkspace = { status:string; recovery_available:boolean }
+export type RecoveryCheckpoint = {revision?:number; reactive_affected_tasks?:string[]}
+export type RecoveryTask = {status:string}
+
+export function workspaceRecoveryState(
+  workspace:RecoveryWorkspace|undefined,
+  checkpoint:RecoveryCheckpoint|undefined,
+  tasks:readonly RecoveryTask[],
+) {
+  const hasCheckpoint=typeof checkpoint?.revision==='number' &&
+    Number.isInteger(checkpoint.revision) && checkpoint.revision>=0
+  const hasFailedWork=tasks.some(task=>['FAILED','BLOCKED'].includes(task.status))
+  const hasReactiveWork=Boolean(checkpoint?.reactive_affected_tasks?.length)
+  const hasRecoveryRight=Boolean(workspace?.recovery_available)
+  const canResume=hasRecoveryRight && hasCheckpoint &&
+    ['PAUSED','INTERRUPTED'].includes(workspace?.status||'')
+  const canRetry=hasRecoveryRight && hasCheckpoint &&
+    ['FAILED','PARTIAL','NEEDS_REVIEW'].includes(workspace?.status||'') &&
+    (hasFailedWork || hasReactiveWork)
+  const reviewOnly=workspace?.status==='NEEDS_REVIEW' && tasks.length>0 &&
+    tasks.every(task=>task.status==='COMPLETED') && !hasReactiveWork
+  const missingCheckpoint=Boolean(workspace &&
+    ['FAILED','PARTIAL','PAUSED','INTERRUPTED'].includes(workspace.status) && !hasCheckpoint)
+  return {hasCheckpoint,hasFailedWork,hasReactiveWork,canResume,canRetry,reviewOnly,missingCheckpoint}
+}
