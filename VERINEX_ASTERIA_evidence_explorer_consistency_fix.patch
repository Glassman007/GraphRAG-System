+    expect(screen.getByTestId('graph-nodes').textContent).toContain('"type":"Evidence"')
+    expect(vi.mocked(getNeighbors).mock.calls[0][0].graphId).toBe('asteria_company_brain_v1')
+  })
+
+  it('refuses unscoped evidence queries', ()=>{
