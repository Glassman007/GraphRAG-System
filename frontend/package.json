{
  "name": "graphhacks-phase12-ui",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
