FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=company_brain
FALKORDB_PASSWORD=
GRAPH_TENANT_ID=northstar

# Phase 9 ingestion (fixture is the safe/default mode)
GRAPH_HACKS_INGESTION_MODE=fixture
GRAPH_HACKS_ARTIFACT_ROOT=.graphhacks_artifacts
GRAPH_HACKS_ARTIFACT_THRESHOLD_BYTES=16384

# Optional read-only live provider configuration. Do not commit secrets.
GITHUB_API_URL=https://api.github.com
GITHUB_ORG=
GITHUB_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_USER=
JIRA_TOKEN=
SLACK_CHANNEL=
SLACK_BOT_TOKEN=
INTERNAL_API_BASE_URL=
INTERNAL_API_PATH=/records
INGESTION_DATABASE_DSN=

# Component 5 — Governed Tool Execution (OFF by default)
# Configure only a trusted organizational HTTPS action receiver; no dynamic agent URLs.
# The receiver must enforce the Idempotency-Key header, caller authorization and target scope.
# Separate authenticated GET readback at STATUS_URL/{operation_key} is needed for COMPLETED state.
# Never commit these bearer tokens. A 2-person APPROVE_ACTION principal is also required.
GRAPH_HACKS_GOVERNED_DEPLOYMENT_ROLLBACK_URL=
GRAPH_HACKS_GOVERNED_DEPLOYMENT_ROLLBACK_TOKEN=
GRAPH_HACKS_GOVERNED_DEPLOYMENT_ROLLBACK_STATUS_URL=
GRAPH_HACKS_GOVERNED_INCIDENT_NOTIFICATION_URL=
GRAPH_HACKS_GOVERNED_INCIDENT_NOTIFICATION_TOKEN=
GRAPH_HACKS_GOVERNED_INCIDENT_NOTIFICATION_STATUS_URL=

# Component 1 - model-backed agent runtime (set actual secrets in ignored .env / OS environment)
GRAPH_HACKS_AGENT_PROVIDER=groq
GROQ_API_KEY=
GRAPH_HACKS_AGENT_MODEL=openai/gpt-oss-120b
GRAPH_HACKS_GROQ_TPM=8000
# Optional alternative: GRAPH_HACKS_AGENT_PROVIDER=openai and OPENAI_API_KEY=...
# Compatible local provider requires GRAPH_HACKS_AGENT_BASE_URL and, if needed, GRAPH_HACKS_AGENT_API_KEY.
